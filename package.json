{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — 3D third-person game & deterministic headless engine (Day 12 AI SDLC)",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/run-game.mjs",
    "build:web": "vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build": "npm run typecheck && npm run build:cli && npm run build:web",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "headless": "node dist-cli/cli/headless.js",
    "soak": "node --expose-gc dist-cli/cli/soak.js",
    "bench": "node scripts/bench.mjs",
    "verify:determinism": "node scripts/verify-phase3.mjs",
    "verify": "npm run typecheck && npm run build:cli && npm test && npm run verify:determinism && npm run build:web"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}